# ---------------------------------------------------------------------------
# Rahasia dan state runtime. JANGAN PERNAH masuk repo.
# ---------------------------------------------------------------------------
session.json
*.token
*.snk
*.pfx
agent-workspace/
.agents/
mcp_config.json
.env
.env.*

# Bukti dan trace berisi path mesin serta nama user Windows
trace/
output/
evidence/
*.trace.jsonl
host-status.json

# ---------------------------------------------------------------------------
# Build .NET
# ---------------------------------------------------------------------------
bin/
obj/
*.user
*.suo
.vs/
*.dll
*.pdb
*.tlb

# ---------------------------------------------------------------------------
# Web / Node
# ---------------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Python sidecar
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------------
# File CAD. Fixture test disertakan secara eksplisit lewat negasi di bawah.
# ---------------------------------------------------------------------------
*.SLDPRT
*.SLDASM
*.SLDDRW
*.sldprt
*.sldasm
*.slddrw
~$*
*.bak
# Part acuan golden test. Satu-satunya berkas CAD yang MEMANG milik repo:
# nilai harapan di plat-referensi.json diturunkan dari geometrinya, jadi tanpa
# berkas ini golden test tidak bisa dijalankan siapa pun selain yang membuatnya.
!tests/golden/*.SLDPRT
!tests/golden/*.sldprt

# ...TAPI bukan berkas kunci SolidWorks. Pengecualian di atas berada SETELAH
# aturan `~$*`, dan di gitignore aturan belakangan menang - jadi tanpa baris
# ini, `~$plat-referensi.SLDPRT` yang dibuat SolidWorks saat part terbuka ikut
# ter-commit. Berkas itu berumur sependek sesi dan tidak berarti apa-apa bagi
# orang lain.
tests/golden/~$*

!tests/fixtures/**/*.SLDPRT
!tests/fixtures/**/*.SLDASM

# ---------------------------------------------------------------------------
# Sistem
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
