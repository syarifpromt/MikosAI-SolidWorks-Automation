<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MikosAI.Core sengaja TIDAK punya dependensi SolidWorks.

    Itu bukan kebetulan: pemisahan ini yang membuat Jalur Platform bisa bekerja
    penuh tanpa SolidWorks terpasang, dan membuat seluruh logika keamanan
    (VerificationGate, RecoveryAdvisor, CapabilityLedger, PlanValidator) bisa
    diuji cepat tanpa membuka CAD.

    Jangan pernah menambahkan referensi SolidWorks.Interop.* di sini.
    Semua itu milik MikosAI.Addin.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>MikosAI.Core</AssemblyName>
    <RootNamespace>MikosAI.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
  </ItemGroup>

  <!--
    Beberapa helper (redaksi trace, parsing status) sengaja internal supaya tidak
    jadi bagian dari API publik, tapi tetap perlu diuji langsung karena itu
    mekanisme keamanan.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MikosAI.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
