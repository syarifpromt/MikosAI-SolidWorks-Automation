<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SENGAJA TIDAK ADA DI MikosAI.sln.

    Build nyata butuh PIA SolidWorks dari instalasi lokal, jadi kalau ikut di
    solution, `dotnet build` dan `dotnet test` akan gagal di mesin tanpa
    SolidWorks. Bangun lewat scripts/addin.ps1.

    DUA MODE BUILD:

      -Action Build         PIA asli dari instalasi SolidWorks. Ini yang
                            menghasilkan DLL yang dipakai sungguhan.

      -Action CompileCheck  Stub ISwAddin lokal, TANPA PIA. Hanya untuk
                            memverifikasi kode add-in benar secara tipe di mesin
                            tanpa SolidWorks. Outputnya tidak boleh dipakai.

    Permukaan PIA saat kompilasi sengaja menyusut ke SATU interface: ISwAddin.
    Semua panggilan SolidWorks lain late-bound lewat SolidWorksApi, supaya
    tanda tangan API yang berbeda antarversi jadi error terstruktur di
    host-status.json, bukan error compiler di mesin pengguna.

    PIA TIDAK di-vendor ke repo - redistribusinya dibatasi lisensi Dassault.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Add-in SolidWorks dimuat in-process ke proses 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>MikosAI.Addin</AssemblyName>
    <RootNamespace>MikosAI.Addin</RootNamespace>

    <!-- Assembly tidak ComVisible secara global; hanya kelas add-in yang ditandai. -->
    <ComVisible>false</ComVisible>

    <!--
      TIDAK ada strong naming, dan itu disengaja.

      RegAsm /codebase merekam PATH assembly, bukan identitas strong name, jadi
      SolidWorks tidak membutuhkannya. Strong name juga BUKAN code signing
      Authenticode - distribusi tetap butuh penandatanganan di pipeline rilis.

      Menambahkannya justru merugikan: assembly strong-named tidak boleh
      mereferensi yang tidak (CS8002), jadi MikosAI.Core harus ikut ditandatangani
      - dan itu membuat `dotnet build` bergantung pada kunci yang digenerate dan
      tidak di-commit, sehingga clone baru gagal build.

      scripts/New-StrongNameKey.ps1 tetap ada untuk kebutuhan rilis nanti.
    -->
  </PropertyGroup>

  <!--
    Deteksi PIA otomatis, supaya proyek ini AMAN ikut di MikosAI.sln.

    Kalau SolidWorksApiDir tidak diberikan eksplisit, coba lokasi umum. Kalau
    tetap tidak ada, turun ke mode compile-check alih-alih menggagalkan build.

    Alasannya: proyek ini pernah menggagalkan seluruh solution begitu ikut
    ditambahkan ke MikosAI.sln - termasuk `dotnet test` dan langkah build di
    setup.ps1. Dengan fallback ini, `dotnet build` jalan di mesin mana pun, DAN
    kode add-in otomatis ikut diperiksa tipenya setiap kali.

    scripts/setup.ps1 tetap meneruskan path hasil deteksi registry, yang lebih
    andal daripada pencocokan path di sini.
  -->
  <PropertyGroup Condition="'$(UsePiaStub)' != 'true' And '$(SolidWorksApiDir)' == ''">
    <!--
      1. Variabel lingkungan. MSBuild mengekspos env var sebagai properti, jadi
         MIKOSAI_SW_API_DIR bisa menunjuk instalasi tidak standar tanpa perlu
         menyentuh berkas ini.
    -->
    <SolidWorksApiDir Condition="'$(MIKOSAI_SW_API_DIR)' != '' And Exists('$(MIKOSAI_SW_API_DIR)\SolidWorks.Interop.swpublished.dll')">$(MIKOSAI_SW_API_DIR)</SolidWorksApiDir>

    <!--
      2. Registry, lewat rantai yang sama dengan Get-SolidWorksApiDir di
         scripts\lib\MikosAI.Env.ps1:

           CLSID SldWorks.Application -> LocalServer32 -> folder exe -> api\redist

         Ditambahkan setelah pencocokan path saja terbukti tidak cukup:
         SolidWorks di mesin pengembang terpasang di D:, jadi kedua kandidat
         "C:\Program Files" di bawah selalu gagal dan `dotnet build` DIAM-DIAM
         turun ke mode compile-check - padahal build nyata sebenarnya mungkin.

         Bug yang sama pernah ada di addin.ps1 dan sudah diperbaiki di sana
         dengan mendelegasikan ke lib; di sini ia tetap hidup sampai sekarang.
    -->
    <PiaClsid>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SldWorks.Application\CLSID', null, null, RegistryView.Registry64, RegistryView.Default))</PiaClsid>
    <PiaExe Condition="'$(SolidWorksApiDir)' == '' And '$(PiaClsid)' != ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\$(PiaClsid)\LocalServer32', null, null, RegistryView.Registry64, RegistryView.Default))</PiaExe>

    <!-- LocalServer32 menyimpan path yang dikutip. Tanda kutipnya harus dilepas. -->
    <PiaExe Condition="'$(PiaExe)' != ''">$(PiaExe.Replace('&quot;', '').Trim())</PiaExe>
    <PiaDirRegistry Condition="'$(PiaExe)' != ''">$([System.IO.Path]::GetDirectoryName('$(PiaExe)'))</PiaDirRegistry>

    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == '' And '$(PiaDirRegistry)' != '' And Exists('$(PiaDirRegistry)\api\redist\SolidWorks.Interop.swpublished.dll')">$(PiaDirRegistry)\api\redist</SolidWorksApiDir>

    <!-- 3. Path umum, sebagai usaha terakhir. -->
    <PiaKandidat1>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</PiaKandidat1>
    <PiaKandidat2>C:\Program Files\SolidWorks Corp\SolidWorks\api\redist</PiaKandidat2>

    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == '' And Exists('$(PiaKandidat1)\SolidWorks.Interop.swpublished.dll')">$(PiaKandidat1)</SolidWorksApiDir>
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == '' And Exists('$(PiaKandidat2)\SolidWorks.Interop.swpublished.dll')">$(PiaKandidat2)</SolidWorksApiDir>

    <!-- Masih tidak ada: turun ke stub, jangan gagalkan solution. -->
    <UsePiaStub Condition="'$(SolidWorksApiDir)' == ''">true</UsePiaStub>
    <PiaTurunKeStub Condition="'$(SolidWorksApiDir)' == ''">true</PiaTurunKeStub>
  </PropertyGroup>

  <!--
    Mode compile-check: stub, tanpa PIA.

    Nama assembly dan folder output SENGAJA berbeda, supaya build stub tidak
    pernah bisa menimpa DLL yang didaftarkan ke SolidWorks. Registrasi menunjuk
    bin\Release\net48\MikosAI.Addin.dll, yang tidak pernah ditulis mode ini.
  -->
  <PropertyGroup Condition="'$(UsePiaStub)' == 'true'">
    <DefineConstants>$(DefineConstants);MIKOSAI_PIA_STUB</DefineConstants>
    <AssemblyName>MikosAI.Addin.CompileCheck</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)bin\compilecheck\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <!--
    Halaman UI TaskPane. Dikopi ke folder output supaya WebView2 bisa
    menavigasinya sebagai berkas lokal - tidak ada CDN, tidak ada jaringan.
  -->
  <ItemGroup>
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikosAI.Core\MikosAI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!--
    Stub hanya ikut dikompilasi di mode compile-check. Di build nyata ia
    dikecualikan sepenuhnya, jadi tidak ada risiko tanda tangan stub sampai ke
    runtime.
  -->
  <ItemGroup Condition="'$(UsePiaStub)' != 'true'">
    <Compile Remove="Interop\SwAddinStub.cs" />
  </ItemGroup>

  <!--
    PIA dari instalasi lokal. Hanya swpublished - ISwAddin satu-satunya tipe
    PIA yang kita butuh saat kompilasi.

    EmbedInteropTypes=true (NoPIA) MENANAMKAN definisi ISwAddin ke dalam
    assembly kita, sehingga TIDAK ADA dependensi assembly saat runtime.

    Ini memperbaiki dua hal sekaligus:

    1. RegAsm harus MEMUAT assembly kita untuk memanggil [ComRegisterFunction].
       Dengan referensi biasa, CLR butuh swpublished.dll saat itu - dan PIA
       SolidWorks tidak ada di GAC, jadi registrasi gagal dengan
       "Could not load file or assembly 'SolidWorks.Interop.swpublished'".

    2. Referensi biasa mengikat versi PIA secara keras (mis. 33.1.1.1 untuk
       SW2025). Add-in yang dibangun di satu versi SolidWorks lalu dipakai di
       versi lain akan bermasalah - dan dua laptop kami bisa beda versi.
       Type equivalence pada interop yang ditanam membuat interface-nya
       menyatu dengan apa pun yang dimuat SolidWorks.

    Kalau ternyata penanaman bermasalah, jalur mundurnya adalah copy-local:
      -p:EmbedPia=false
    Itu mengopi swpublished.dll ke folder output, yang juga sah - folder
    sumbernya memang bernama "redist".
  -->
  <PropertyGroup>
    <EmbedPia Condition="'$(EmbedPia)' == ''">true</EmbedPia>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePiaStub)' != 'true' And '$(SolidWorksApiDir)' != ''">
    <!-- ISwAddin: interface yang diimplementasikan add-in. -->
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>$(EmbedPia)</EmbedInteropTypes>
      <!-- Kalau ditanam, tidak perlu dikopi. Kalau tidak, WAJIB dikopi. -->
      <Private Condition="'$(EmbedPia)' != 'true'">true</Private>
      <Private Condition="'$(EmbedPia)' == 'true'">false</Private>
    </Reference>

    <!--
      ISldWorks: objek aplikasi.

      WAJIB bertipe. Versi pertama memakai dynamic dan setiap panggilan gagal
      dengan 0x8002802B TYPE_E_ELEMENTNOTFOUND - interface SolidWorks
      dideskripsikan type library dan dipanggil lewat vtable, tidak bisa dicari
      namanya lewat IDispatch. Lihat komentar di SolidWorksApi.cs.
    -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>$(EmbedPia)</EmbedInteropTypes>
      <Private Condition="'$(EmbedPia)' != 'true'">true</Private>
      <Private Condition="'$(EmbedPia)' == 'true'">false</Private>
    </Reference>

    <!-- Tipe enum/konstanta yang dirujuk tanda tangan ISldWorks. -->
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>$(EmbedPia)</EmbedInteropTypes>
      <Private Condition="'$(EmbedPia)' != 'true'">true</Private>
      <Private Condition="'$(EmbedPia)' == 'true'">false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Gagal dengan pesan yang bisa ditindaklanjuti, bukan dengan puluhan error
    "type not found" yang menyesatkan.
  -->
  <!--
    Cap commit git dan waktu build ke metadata assembly.

    Alasannya ditemukan dengan cara yang mahal: dua kali kami mendiagnosis error
    runtime dari kode yang sudah diperbaiki, karena DLL yang dimuat SolidWorks
    ternyata build lama. Satu-satunya petunjuknya adalah teks error yang
    kebetulan masih memuat jejak kode usang.

    Dengan cap ini, -Action Probe bisa membandingkan commit DLL yang BERJALAN
    dengan HEAD repo dan langsung bilang "rebuild dulu".
  -->
  <!--
    Kopi WebView2Loader.dll native ke root output.

    Paket WebView2 menaruhnya di runtimes\win-x64
ative\ - konvensi NuGet yang
    diselesaikan otomatis oleh .NET Core, TAPI net48 tidak melakukannya. Loader
    WebView2 mencari DLL native itu di folder assembly, jadi tanpa kopi ini
    panel akan gagal saat runtime dengan "WebView2Loader.dll not found", dan
    gejalanya cuma panel kosong.

    Terdeteksi saat memeriksa isi folder output, bukan saat build - build sendiri
    berhasil tanpa keluhan.
  -->
  <Target Name="KopiWebView2Loader" AfterTargets="Build">
    <ItemGroup>
      <_LoaderWebView2 Include="$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(_LoaderWebView2)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_LoaderWebView2)' != ''" />

    <Warning Condition="'@(_LoaderWebView2)' == '' And '$(UsePiaStub)' != 'true'"
             Text="WebView2Loader.dll native tidak ditemukan. Panel TaskPane tidak akan bisa dimuat." />
  </Target>

  <Target Name="CapCommitGit" BeforeTargets="CoreGenerateAssemblyInfo">
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory)..\..&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitGit" />
      <Output TaskParameter="ExitCode" PropertyName="KodeKeluarGit" />
    </Exec>

    <PropertyGroup>
      <CommitGit Condition="'$(KodeKeluarGit)' != '0' Or '$(CommitGit)' == ''">(tidak diketahui)</CommitGit>
    </PropertyGroup>

    <!--
      AssemblyAttribute dengan _Parameter1/_Parameter2 adalah mekanisme SDK yang
      benar. Percobaan pertama memakai item group AssemblyMetadata, yang BUKAN
      item yang dikenali SDK - hasilnya assembly tidak punya metadata sama
      sekali, dan deteksi DLL usang diam-diam tidak berfungsi.
    -->
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildCommit</_Parameter1>
        <_Parameter2>$(CommitGit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTime</_Parameter1>
        <_Parameter2>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="CekPiaSolidWorks" BeforeTargets="BeforeBuild">
    <!--
      Turun ke mode compile-check karena SolidWorks tidak terdeteksi.

      Ini WARNING, bukan error: solution harus tetap bisa dibangun di mesin tanpa
      CAD. Tapi harus TERLIHAT, supaya tidak ada yang menyangka sudah punya DLL
      yang bisa didaftarkan.
    -->
    <Warning Condition="'$(PiaTurunKeStub)' == 'true'"
             Text="SolidWorks tidak terdeteksi - MikosAI.Addin dibangun dalam MODE COMPILE-CHECK. Output di bin\compilecheck TIDAK bisa didaftarkan ke SolidWorks. Untuk build nyata: powershell -File scripts\setup.ps1" />

    <!--
      Path diberikan eksplisit tapi isinya salah: itu error, bukan sesuatu yang
      boleh dialihkan ke stub secara diam-diam.
    -->
    <Error Condition="'$(UsePiaStub)' != 'true' And !Exists('$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll')"
           Text="SolidWorks.Interop.swpublished.dll tidak ada di '$(SolidWorksApiDir)'. Jalankan scripts\doctor.ps1 untuk mendeteksi path yang benar." />
    <Error Condition="'$(UsePiaStub)' != 'true' And !Exists('$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll')"
           Text="SolidWorks.Interop.sldworks.dll tidak ada di '$(SolidWorksApiDir)'." />
  </Target>

</Project>
