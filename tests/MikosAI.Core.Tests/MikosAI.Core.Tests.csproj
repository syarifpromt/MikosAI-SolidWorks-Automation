<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>MikosAI.Core.Tests</AssemblyName>
    <RootNamespace>MikosAI.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MikosAI.Core\MikosAI.Core.csproj" />

    <!--
      MikosAI.Addin dirujuk HANYA untuk urutan build, bukan untuk diikat tipenya.

      AddinThreadGuardTests memuat DLL-nya lewat refleksi, dan itu disengaja:
      nama assembly-nya berbeda antara build nyata (MikosAI.Addin) dan mode
      compile-check (MikosAI.Addin.CompileCheck). Perbedaan nama itu adalah
      pengaman - ia mencegah DLL stub didaftarkan ke SolidWorks - jadi yang
      harus menyesuaikan adalah test-nya, bukan pengamannya.

      ReferenceOutputAssembly=false memberi urutan build tanpa ikatan tipe,
      sehingga test ini jalan di mesin dengan maupun tanpa SolidWorks.
    -->
    <ProjectReference Include="..\..\src\MikosAI.Addin\MikosAI.Addin.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Round-trip HTTP nyata di McpHttpServerTests butuh HttpClient. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
