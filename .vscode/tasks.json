{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup (satu perintah)",
      "detail": "Periksa lingkungan, build, test, dan registrasi add-in. Aman diulang.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/setup.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "doctor",
      "detail": "Periksa lingkungan dan laporkan apa yang perlu diperbaiki. Read-only.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/doctor.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "Build MikosAI.Core + test. Tidak butuh SolidWorks.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/MikosAI.sln",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "detail": "Jalankan seluruh test. Tidak butuh SolidWorks.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/MikosAI.sln",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "test (watch)",
      "detail": "Jalankan ulang test setiap kali berkas berubah.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "test",
        "--project",
        "${workspaceFolder}/tests/MikosAI.Core.Tests/MikosAI.Core.Tests.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "addin: compile-check",
      "detail": "Verifikasi kode add-in benar secara tipe TANPA SolidWorks, lewat stub ISwAddin.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/addin.ps1",
        "-Action",
        "CompileCheck"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "addin: build",
      "detail": "BUTUH SolidWorks terpasang. Path PIA dideteksi atau diminta.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/addin.ps1",
        "-Action",
        "Build"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "addin: status",
      "detail": "Apa yang terdaftar di registry dan artefak apa yang ada.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/addin.ps1",
        "-Action",
        "Status"
      ],
      "problemMatcher": []
    },
    {
      "label": "addin: probe",
      "detail": "Baca host-status.json dan tegakkan gerbang penerimaan Fase 0.",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/addin.ps1",
        "-Action",
        "Probe"
      ],
      "problemMatcher": []
    }
  ]
}
